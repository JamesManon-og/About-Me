# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated in lib/env.ts.

# Optional. Canonical site URL, used for metadata from Stage 9.
NEXT_PUBLIC_SITE_URL=

# Claude API key (server only). Without it the chat answers "unavailable".
# ANTHROPIC_API_KEY=

# Optional. claude-haiku-4-5 (default), claude-sonnet-5 or claude-opus-5.
# CHAT_MODEL=

# Optional. 1 = scripted mock answers, no key needed. Used by e2e tests.
# Refused on a Vercel production deployment.
# CHAT_MODEL_MOCK=1

# Stage 7: rate limiting (server only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
