# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated in lib/env.ts. None is required: the site runs without any.

# Optional. Canonical site URL for metadata, the sitemap and share images, such as
# https://james.example.com. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Claude API key (server only). Without it the chat answers only from the
# prebuilt answer set (data/james/faq.ts), which costs nothing. With it, questions the set
# doesn't cover go to Claude. Add rate limits (docs/DEPLOYMENT.md) before setting it in
# production.
# ANTHROPIC_API_KEY=

# Optional. claude-haiku-4-5 (default), claude-sonnet-5 or claude-opus-5.
# CHAT_MODEL=

# Optional. 1 = scripted mock answers for unmatched questions, no key needed. Used by
# e2e tests. Refused on a Vercel production deployment.
# CHAT_MODEL_MOCK=1

# Before enabling the Claude path in production: rate limiting (server only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
