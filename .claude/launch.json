{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-mock",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev", "--port", "3001"],
      "env": { "CHAT_MODEL_MOCK": "1" },
      "port": 3001
    },
    {
      "name": "prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "start", "--port", "3100"],
      "port": 3100
    }
  ]
}
